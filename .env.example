# Formspree form id — the part after /f/ in your endpoint URL.
# Create a form at https://formspree.io, then set this in Vercel:
#   vercel env add NEXT_PUBLIC_FORMSPREE_ID production
NEXT_PUBLIC_FORMSPREE_ID=

# Canonical origin, used for metadata, sitemap.xml and OG image URLs.
# Leave unset to fall back to https://oski-media.vercel.app
NEXT_PUBLIC_SITE_URL=
